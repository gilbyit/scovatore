# Copia in .env e compila. Il .env non va su GitHub.

# --- eBay (developer.ebay.com > Application Keys > Production) -------------
EBAY_APP_ID=
EBAY_CERT_ID=
# production | sandbox
EBAY_ENV=production
# Dove ti fai spedire: serve a eBay per calcolare i costi di spedizione giusti
EBAY_BUYER_COUNTRY=IT
EBAY_BUYER_ZIP=10100
# Tetto di chiamate al giorno (UTC), contate nel DB. Il limite eBay di default e' 5000
EBAY_DAILY_CALL_BUDGET=4500

# --- Palantir: piano delle query e scrematura dei titoli -------------------
# URL del gateway OpenAI-compatible, con /v1 finale.
# Dal container Scovatore: nome del servizio sulla rete Docker condivisa.
# Da riga di comando sull'host: http://localhost:<porta>/v1
PALANTIR_BASE_URL=http://palantir-gateway:8080/v1
PALANTIR_API_KEY=
PALANTIR_MODEL=qwen3.5-4b
# 0 = nessun limite
PALANTIR_TPM_LIMIT=0
# response_format json_object; se il gateway lo rifiuta si disattiva da solo
PALANTIR_JSON_MODE=true
PALANTIR_TEMPERATURE=0.2
PALANTIR_TIMEOUT=300
PALANTIR_MAX_TOKENS=1200

# --- Groq: verifica dei requisiti avanzati ---------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Piano gratuito: 8000 token al minuto per modello
GROQ_TPM_LIMIT=8000
GROQ_JSON_MODE=true
# low | medium | high (solo modelli che lo supportano, lascia vuoto per non inviarlo)
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT=120
GROQ_MAX_TOKENS=1500

# --- Pipeline -------------------------------------------------------------
# Chi genera il piano delle query (una chiamata per caccia, poi resta in cache):
# palantir (locale, gratis) | groq (piu' affidabile, poche centinaia di token).
# Se il modello scelto non e' configurato si usa l'altro. Cambiarlo rigenera i piani.
SCOVATORE_PLAN_LLM=groq
# Titoli per richiesta di scrematura a Palantir
SCOVATORE_SCREEN_BATCH=8
# Caratteri di descrizione passati a Groq
SCOVATORE_DESC_MAX_CHARS=2500
# Annunci verificati da Groq per ogni esecuzione di una caccia (gli altri al giro dopo)
SCOVATORE_MAX_VERIFY_PER_RUN=25
# Punteggio minimo per notificare
SCOVATORE_NOTIFY_MIN_SCORE=70

# Dominio dei link agli annunci (interfaccia, notifiche, CSV). Lo stesso ID vale su tutti i
# siti eBay: su quello italiano sei gia' loggato e vedi subito la spedizione verso l'Italia
SCOVATORE_LINK_DOMAIN=ebay.it

# --- Fonti web: Vinted e Subito.it ----------------------------------------
# Non hanno un'API pubblica: si leggono gli stessi endpoint dei loro siti. Pausa in secondi fra due
# richieste allo stesso sito (non scendere sotto 1-2: un blocco dura ore). Vale solo per le cacce che
# attivano la fonte con `fonti: [... vinted, subito]`.
SCOVATORE_SCRAPE_DELAY=2
# Identita' del client. Vuoto = un Firefox generico. Cambiala solo se un sito rifiuta quella di default
# SCOVATORE_USER_AGENT=

# --- Percorsi -------------------------------------------------------------
SCOVATORE_DATA_DIR=./data
SCOVATORE_HUNTS_DIR=./cacce
# SCOVATORE_DB=./data/scovatore.db

# --- Notifiche ntfy (opzionali) -------------------------------------------
# URL completo del topic, per esempio https://ntfy.sh/scovatore-xyz
SCOVATORE_NTFY_URL=
SCOVATORE_NTFY_TOKEN=

# --- Interfaccia web (servizio scovatore-web) -------------------------------
# Porta pubblicata sull'host. 8480, 8481 e 8090 sono gia' usate su NASGUL
SCOVATORE_WEB_PORT=8482
# Vuoto = nessuna protezione e editor delle cacce in sola lettura: per modificare, creare, accendere e
# spegnere le cacce dal web il token e' obbligatorio. Se impostato: apri una volta
# http://nasgul:8482/?token=<valore> e il browser lo ricorda in un cookie
SCOVATORE_WEB_TOKEN=

# INFO: fasi, ogni ricerca, blocchi di scrematura, ogni verifica. DEBUG (o -v): anche
# i singoli scarti con il motivo, le query del piano e i tempi di ogni chiamata LLM
SCOVATORE_LOG_LEVEL=INFO
